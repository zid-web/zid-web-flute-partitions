{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Flûte Partitions",
  "version": "0.1.0",
  "identifier": "fr.flutepartitions.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Flûte Partitions",
        "width": 1200,
        "height": 820,
        "minWidth": 360,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob: mediastream:; connect-src 'self' ipc: http://ipc.localhost https://zid-web-flute-partitions.vercel.app"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Education",
    "shortDescription": "Partitions de flûte interactives",
    "longDescription": "Jouez des partitions de flûte : l'application écoute votre flûte et chaque note s'allume quand vous la réussissez. Fonctionne hors ligne.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "entitlements.plist"
    }
  }
}
